   "evidence": [
    "e4",
    "e5",
    "e6"
   ]
  },
  "HI": {
   "dodACF2026": 2.13,
   "value": 1.38,
   "method": "Set equal to HI-Honolulu (Oahu holds most of the state's construction). DoD data show neighbor-island sites 5-28% above Honolulu (Hilo/Kihei 2.14, Kauai 2.60 vs 2.03); apply a project-specific premium for neighbor islands.",
   "evidence": [
    "e1",
    "e5"
   ]
  },
  "AK-Anchorage": {
   "dodACF2026": 2.2,
   "value": 1.5,
   "method": "No public commercial cross-check found. DoD ACF 2.20 scaled by the Honolulu commercial/DoD ratio (1.38 / 2.03 = 0.680), on the assumption that DoD noncontiguous factors overstate commercial costs similarly. Verify.",
   "evidence": [
    "e1",
    "e3"
   ]
  },
  "AK-Fairbanks": {
   "dodACF2026": 2.25,
   "value": 1.53,
   "method": "Same scaling as AK-Anchorage applied to the DoD Fairbanks ACF 2.25. Verify.",
   "evidence": [
    "e1"
   ]
  },
  "AK": {
   "dodACF2026": 2.47,
   "value": 1.5,
   "method": "Set equal to AK-Anchorage. The DoD statewide site median (2.47) is dominated by remote bases (McGrath/Nome/Barrow 3.17); remote AK work needs a project-specific premium.",
   "evidence": [
    "e1"
   ]
  },
  "TX-DFW": {
   "value": 0.84,
   "method": "Mean of DoD ACF Dallas 0.84 and Fort Worth 0.84.",
   "evidence": [
    "e1"
   ]
  }
