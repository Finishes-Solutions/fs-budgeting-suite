{
  "routes": [
    { "route": "/api/admin-roles", "allowedRoles": ["super_admin"] },
    { "route": "/api/admin-roles/*", "allowedRoles": ["super_admin"] },
    { "route": "/api/analytics", "allowedRoles": ["super_admin"] },
    { "route": "/api/analytics-activity", "allowedRoles": ["super_admin"] },
    { "route": "/api/pricing", "methods": ["PUT"], "allowedRoles": ["pricing_admin", "super_admin"] },
    { "route": "/api/templates", "methods": ["POST", "PUT", "PATCH"], "allowedRoles": ["pricing_admin", "super_admin"] },
    { "route": "/api/templates/*", "methods": ["POST", "PUT", "PATCH"], "allowedRoles": ["pricing_admin", "super_admin"] },
    { "route": "/api/*", "allowedRoles": ["authenticated"] },
    { "route": "/*", "allowedRoles": ["authenticated"] }
  ],
  "responseOverrides": {
    "401": { "redirect": "/.auth/login/aad?post_login_redirect_uri=.referrer", "statusCode": 302 }
  },
  "auth": {
    "identityProviders": {
      "azureActiveDirectory": {
        "registration": {
          "openIdIssuer": "https://login.microsoftonline.com/bfbd2cad-3f2f-42b5-a374-5867d67dde93/v2.0",
          "clientIdSettingName": "AAD_CLIENT_ID",
          "clientSecretSettingName": "AAD_CLIENT_SECRET"
        },
        "login": {
          "loginParameters": ["prompt=select_account"]
        }
      }
    }
  },
  "navigationFallback": { "rewrite": "/index.html", "exclude": ["/api/*", "/.auth/*"] },
  "platform": { "apiRuntime": "node:22" }
}
